// LINFOVIT — modelo de datos
// SQLite para desarrollo local. Para producción use PostgreSQL:
//   provider = "postgresql" + DATABASE_URL de su proveedor.
// El esquema evita enums y tipos Json para mantener compatibilidad entre motores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("ADMIN")
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  volumeMl    Int      @default(60)
  sku         String
  stock       Int      @default(0)
  active      Boolean  @default(true)
  imageFront  String
  imageBack   String?
  imageAngle  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  packs       Pack[]
  reviews     Review[]
}

model Pack {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  slug         String  @unique
  quantity     Int
  priceCop     Int
  compareAtCop Int?
  badge        String?
  description  String?
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        OrderItem[]

  @@index([productId])
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  accessToken         String      @unique
  status              String      @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | SHIPPED | DELIVERED | REFUNDED
  paymentStatus       String      @default("PENDING") // PENDING | APPROVED | REJECTED | IN_PROCESS | REFUNDED | CANCELLED
  paymentStatusDetail String?
  mpPreferenceId      String?
  mpPaymentId         String?
  customerName        String
  customerEmail       String
  customerPhone       String
  department          String
  city                String
  address             String
  addressExtra        String?
  notes               String?
  subtotalCop         Int
  shippingCop         Int
  discountCop         Int         @default(0)
  totalCop            Int
  currency            String      @default("COP")
  promoCode           String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?
  fbclid              String?
  gclid               String?
  ttclid              String?
  landingPath         String?
  userAgent           String?
  ip                  String?
  paidAt              DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  trackingNumber      String?
  trackingUrl         String?
  adminNotes          String?
  confirmationSentAt  DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
  payments            Payment[]
  review              Review?
  emails              EmailLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packId       String?
  pack         Pack?   @relation(fields: [packId], references: [id], onDelete: SetNull)
  productId    String?
  productName  String
  packName     String
  quantity     Int
  units        Int
  unitPriceCop Int
  lineTotalCop Int

  @@index([orderId])
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mpPaymentId  String    @unique
  status       String
  statusDetail String?
  method       String?
  amountCop    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?

  @@index([orderId])
}

model Review {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId          String?   @unique
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  name             String
  email            String?
  city             String?
  rating           Int
  title            String?
  body             String
  photoUrl         String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  verifiedPurchase Boolean   @default(true)
  adminNote        String?
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  @@index([productId, status])
  @@index([createdAt])
}

model Testimonial {
  id             String    @id @default(cuid())
  name           String
  kind           String    @default("CUSTOMER") // CUSTOMER | COLLABORATOR
  role           String?
  rating         Int       @default(5)
  quote          String
  photoUrl       String?
  experiencedAt  DateTime?
  consentRef     String?
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | HIDDEN
  featured       Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, sortOrder])
}

model ShippingRate {
  id         String  @id @default(cuid())
  department String
  city       String?
  priceCop   Int
  etaMinDays Int     @default(2)
  etaMaxDays Int     @default(5)
  active     Boolean @default(true)

  @@unique([department, city])
  @@index([department])
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String // PERCENT | FIXED
  value          Int
  minSubtotalCop Int?
  maxUses        Int?
  uses           Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  sessionId   String
  path        String?
  packId      String?
  orderId     String?
  valueCop    Int?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

model EmailLog {
  id         String   @id @default(cuid())
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  kind       String
  provider   String
  providerId String?
  status     String
  error      String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String
  topic      String?
  resourceId String?
  status     String
  message    String?
  payload    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
