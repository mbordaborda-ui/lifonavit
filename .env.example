# Copie este archivo como .env y complete los valores.

# Base de datos. SQLite en desarrollo; PostgreSQL en producción.
DATABASE_URL="file:./dev.db"

APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firmar la sesión del administrador (mínimo 32 caracteres).
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# Administrador inicial creado por `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador LINFOVIT"

# Mercado Pago Colombia — https://www.mercadopago.com.co/developers
# Mientras estén vacías, el checkout mostrará un aviso claro y NO simulará pagos.
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""

# Solo para la prueba automatizada con scripts/mock-mp.mjs.
# En producción debe quedar vacío para usar la API oficial.
# MP_API_BASE="http://localhost:4001"

# Correo transaccional (Resend). Sin credenciales, el correo queda registrado
# en EmailLog como SKIPPED y visible en el panel administrativo.
RESEND_API_KEY=""
EMAIL_FROM="LINFOVIT <pedidos@linfovit.co>"
ORDER_NOTIFICATION_EMAIL=""

# Analítica. Purchase solo se envía desde el servidor tras confirmar el pago.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_TOKEN=""

UPLOAD_DIR="./uploads"
